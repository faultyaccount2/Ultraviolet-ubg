{
	"name": "@titaniumnetwork-dev/ultraviolet",
	"version": "3.2.10",
	"description": "Highly sophisticated proxy used for evading internet censorship or accessing websites in a controlled sandbox using the power of service-workers and more!",
	"main": "lib/index.cjs",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/titaniumnetwork-dev/Ultraviolet.git"
	},
	"files": [
		"dist",
		"lib",
		"uv.d.ts",
		"client.d.ts"
	],
	"type": "module",
	"scripts": {
		"build": "node scripts/build.js",
		"dev": "node scripts/dev.js",
		"build:uv": "node build.js",
		"prepack": "npm run build:uv",
		"test": "node --test tests/*.test.js",
		"test:browser": "playwright test",
		"lint:app": "eslint frontend shared api proxy scripts tests playwright.config.js",
		"format": "prettier --config .prettierrc.js --write .",
		"lint": "eslint ./src/",
		"lint:fix": "eslint ./src/ --fix"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.0",
		"@eslint/js": "^9.21.0",
		"@playwright/test": "^1.56.1",
		"esbuild": "^0.25.0",
		"eslint": "^9.21.0",
		"globals": "^16.0.0",
		"prettier": "^3.5.3",
		"rimraf": "^6.0.1",
		"supabase": "^3.1.0"
	},
	"dependencies": {
		"@gorhill/ubo-core": "0.1.30",
		"@supabase/supabase-js": "^2.119.0",
		"astring": "^1.9.0",
		"events": "^3.3.0",
		"idb": "^8.0.2",
		"ipaddr.js": "^2.2.0",
		"meriyah": "^6.0.5",
		"parse5": "^7.2.1",
		"postcss": "^8.5.6",
		"postcss-value-parser": "^4.2.0",
		"set-cookie-parser": "^2.7.1"
	}
}
